rules_version = '2';
// Reglas de la base de datos (varios equipos).
// Cópialas en Firebase → Firestore → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasEmail() { return signedIn() && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // getAfter: también vale en el mismo lote en que se crea el equipo
    function isAdminOf(e) {
      return hasEmail() &&
        myEmail() in getAfter(/databases/$(database)/documents/equipos/$(e)).data.admins;
    }
    // El propietario no cambia nunca y siempre sigue siendo administrador.
    // Un equipo antiguo sin propietario lo puede reclamar solo quien lo creó.
    function ownerOk() {
      let before = resource.data.get('propietario', '');
      let after = request.resource.data.get('propietario', '');
      return ((before == '' && (after == '' || (after == myEmail() && request.auth.uid == resource.data.get('creador', '')))) ||
              (before != '' && after == before)) &&
             (after == '' || after in request.resource.data.admins);
    }
    function validTeam() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60 &&
        d.admins is list && d.admins.size() > 0 && d.admins.size() <= 20 &&
        d.get('escudo', '').size() < 300000;
    }

    match /equipos/{e} {
      // Con el código se puede ver el equipo; nadie puede listar todos los equipos.
      allow get: if signedIn();
      allow list: if false;
      allow create: if hasEmail() && myEmail() in request.resource.data.admins && validTeam() &&
                       request.resource.data.get('propietario', '') == myEmail();
      allow update: if isAdminOf(e) && validTeam() && myEmail() in resource.data.admins && ownerOk() &&
                       // El fantasy solo lo activa o desactiva el propietario
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fantasy']) ||
                        resource.data.get('propietario', '') == myEmail());
      allow delete: if hasEmail() && (resource.data.get('propietario', '') == myEmail() ||
                       (resource.data.get('propietario', '') == '' && myEmail() in resource.data.admins));

      match /jugadores/{id} {
        allow read: if signedIn();
        allow create, delete: if isAdminOf(e);
        // Un jugador puede vincular su cuenta a un nombre libre, o desvincularse. Nada más.
        allow update: if isAdminOf(e) || (
          hasEmail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']) &&
          ((resource.data.get('email', '') == '' && request.resource.data.email == myEmail()) ||
           (resource.data.get('email', '') == myEmail() && request.resource.data.email == ''))
        ) || (
          // Cada jugador puede guardar sus días fijos de «no puedo ir»
          hasEmail() && resource.data.get('email', '') == myEmail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diasNo', 'diasNota', 'cumple']) &&
          request.resource.data.get('diasNo', []) is list && request.resource.data.get('diasNo', []).size() <= 7
        );
      }
      match /tipos/{id}  { allow read: if signedIn(); allow write: if isAdminOf(e); }
      match /multas/{id} { allow read: if signedIn(); allow write: if isAdminOf(e); }

      // Planes (cenas, lotería…): los crean los administradores; cada uno vota y se apunta con su propia respuesta
      match /planes/{p} {
        allow read: if signedIn();
        allow write: if isAdminOf(e);
        match /respuestas/{who} {
          allow read: if signedIn();
          allow create, update: if hasEmail() && who == myEmail() &&
            get(/databases/$(database)/documents/equipos/$(e)/planes/$(p)).data.get('cerrado', false) != true;
          allow delete: if isAdminOf(e) || (hasEmail() && who == myEmail());
        }
        match /propuestas/{id} {
          allow read: if signedIn();
          allow create: if hasEmail() && request.resource.data.autor == myEmail() &&
            request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 80 &&
            get(/databases/$(database)/documents/equipos/$(e)/planes/$(p)).data.get('cerrado', false) != true;
          allow delete: if isAdminOf(e) || (hasEmail() && resource.data.autor == myEmail());
        }
      }

      // Scouting: la plantilla del rival la editan los administradores; notas, cualquiera con cuenta
      match /rivales/{r} {
        allow read: if signedIn();
        allow write: if isAdminOf(e);
        match /notas/{n} {
          allow read: if signedIn();
          allow create: if hasEmail() && request.resource.data.autor == myEmail() &&
            request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500;
          allow delete: if isAdminOf(e) || (hasEmail() && resource.data.autor == myEmail());
        }
      }

      // Fantasy: el estado y los resultados solo los escribe la tarea automática.
      match /fantasy/{doc} {
        allow read: if signedIn();
        // Solo el propietario, para importar una liga anterior (valores y clasificación)
        allow write: if hasEmail() && get(/databases/$(database)/documents/equipos/$(e)).data.get('propietario', '') == myEmail();
      }
      match /jornadas/{j} {
        allow read: if signedIn();
        allow write: if false;
        // Nadie puede ver el quinteto ni las notas de nadie: cada uno solo lee y escribe lo suyo.
        match /alineaciones/{who} {
          allow read: if hasEmail() && who == myEmail();
          allow create, update: if hasEmail() && who == myEmail() &&
            get(/databases/$(database)/documents/equipos/$(e)).data.get('fantasy', {}).get('activo', false) == true &&
            request.resource.data.jugadores is list && request.resource.data.jugadores.size() == 5 &&
            request.resource.data.capitan in request.resource.data.jugadores &&
            request.resource.data.actualizado == request.time;
          allow delete: if hasEmail() && who == myEmail();
        }
        match /votos/{who} {
          allow read: if hasEmail() && who == myEmail();
          allow create, update: if hasEmail() && who == myEmail() &&
            request.resource.data.notas is map && request.resource.data.actualizado == request.time;
        }
      }

      // Gastos del bote, registro de cambios y recordatorios de pago: los escriben los administradores
      match /gastos/{id} { allow read: if signedIn(); allow write: if isAdminOf(e); }
      match /registro/{id} { allow read: if signedIn(); allow create: if isAdminOf(e); allow update, delete: if false; }
      match /recordatorios/{id} { allow read, create: if isAdminOf(e); allow update, delete: if false; }

      // Tablón de avisos: todos leen, solo los administradores escriben.
      match /avisos/{id} {
        allow read: if signedIn();
        allow create: if isAdminOf(e) && request.resource.data.texto is string &&
                         request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 300;
        allow update, delete: if isAdminOf(e);
      }

      // Entrenos y partidos. Cada jugador solo puede cambiar su propia respuesta (voy / no voy)
      // y su comentario; pasar lista, crear y borrar es cosa de los administradores.
      match /eventos/{id} {
        allow read: if signedIn();
        allow create, delete: if isAdminOf(e);
        allow update: if isAdminOf(e) || (
          hasEmail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirma', 'notas']) &&
          request.resource.data.get('confirma', {}).diff(resource.data.get('confirma', {})).affectedKeys().hasOnly([myEmail()]) &&
          request.resource.data.get('notas', {}).diff(resource.data.get('notas', {})).affectedKeys().hasOnly([myEmail()]) &&
          request.resource.data.get('confirma', {}).get(myEmail(), '') in ['si', 'no', ''] &&
          request.resource.data.get('notas', {}).get(myEmail(), '').size() <= 80 &&
          // Pasado el cierre del plazo ya no se puede contestar
          (resource.data.get('cierre', 0) == 0 || request.time.toMillis() < resource.data.cierre)
        );
      }
    }

    // Sugerencias de mejora: cualquiera puede enviar; solo las lee el propietario de la app
    // (el propietario del equipo ONTINYENT).
    function isAppOwner() {
      return hasEmail() &&
        get(/databases/$(database)/documents/equipos/ONTINYENT).data.get('propietario', '') == myEmail();
    }
    match /sugerencias/{id} {
      allow create: if hasEmail() && request.resource.data.autor == myEmail() && request.resource.data.texto is string &&
        request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500;
      allow read, update, delete: if isAppOwner();
    }

    // Lista de equipos de cada persona (solo la ve ella misma)
    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Móviles que reciben notificaciones. Nadie puede leer la lista desde la app.
    match /tokens/{token} {
      allow create, update, delete: if signedIn();
      allow read: if false;
    }

    // Datos de la versión anterior (un solo equipo): solo lectura, para pasarlos al sistema nuevo.
    match /jugadores/{id} { allow read: if signedIn(); }
    match /tipos/{id}     { allow read: if signedIn(); }
    match /multas/{id}    { allow read: if signedIn(); }
    match /ajustes/{id}   { allow read: if signedIn(); }
  }
}
