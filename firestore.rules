rules_version = '2';
// Reglas de la base de datos. Cópialas en Firebase → Firestore → Reglas (GUIA.md, paso 3).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function hasEmail() { return signedIn() && request.auth.token.email != null; }
    function isAdmin() {
      return hasEmail() &&
        exists(/databases/$(database)/documents/ajustes/general) &&
        myEmail() in get(/databases/$(database)/documents/ajustes/general).data.admins;
    }

    // Todo el que abre la app (aunque no tenga cuenta) puede ver las multas.
    // Solo los administradores pueden cambiarlas.
    match /jugadores/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /tipos/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /multas/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }

    match /ajustes/{id} {
      allow read: if signedIn();
      // Primer arranque: quien configura el equipo se pone como primer administrador.
      allow create: if id == 'general' && hasEmail() && request.resource.data.admins == [myEmail()];
      allow update, delete: if isAdmin();
    }

    // Móviles que reciben notificaciones. Nadie puede leer la lista desde la app.
    match /tokens/{token} {
      allow create, update, delete: if signedIn();
      allow read: if false;
    }
  }
}
